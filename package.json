{
  "name": "port-one-payment-poc",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "db:init": "pnpm prisma:push && pnpm prisma:seed",
    "db:reset": "pnpm prisma:push --accept-data-loss && pnpm prisma:seed",
    "prisma:push": "pnpm --filter backend exec prisma db push",
    "prisma:seed": "pnpm --filter backend seed",
    "prisma:studio": "pnpm --filter backend exec prisma studio",
    "prisma:generate": "pnpm --filter backend exec prisma generate"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
